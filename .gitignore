# Dados brutos e resultados reproduzíveis permanecem fora do repositório.
# As tabelas pequenas e curadas em data/reference são versionadas.

# Ambiente Python
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Dados baixados pelo pipeline
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Resultados de execução
# Uma execução final pode ser adicionada explicitamente com `git add -f`.
outputs/runs/*
!outputs/runs/.gitkeep

# Relatórios, figuras e arquivos temporários gerados localmente
/output/
/tmp/

# Fichas locais da validação humana da V2
outputs/validacao_humana/*
!outputs/validacao_humana/.gitkeep

# Segredos locais
.env
*.key
*.pem
credentials.json

# Ferramentas e sistema operacional
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
